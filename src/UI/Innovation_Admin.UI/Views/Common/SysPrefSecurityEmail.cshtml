@model IEnumerable<Innovation_Admin.UI.Models.SysPrefSecurityEmail.SysPrefSecurityEmailDto>

@{
    Layout = "~/Views/Shared/_AdminHomePage.cshtml";
}
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.css" integrity="sha512-3pIirOrwegjM6erE5gPSwkUzO+3cTjpnV9lexlNZqvupR64iZBnOOTiiLPb9M36zpMScbmUNIcHUqKD47M719g==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/css/SysPrefSecurityEmail/SysPrefSecurityEmail.css" rel="stylesheet" />

</head>

<body>
    <h1>System Preference Security Email</h1>

    <div style="height:40px; margin=0 0; ">
        <p>
            <a asp-action="CreateSysPrefSecurityEmail" class="btn btn-primary float-end"><i class="bi bi-plus-circle"></i> Add</a>
        </p>
    </div>



    <table class="table table-bordered table-hover text-nowrap" id="emailTable">
        <thead>
            <tr>
                <th>Sr.No</th>
                <th>
                    @Html.DisplayNameFor(model => model.DefaultFromName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DefaultFromAddress)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DefaultReplyToAddress)
                </th>
              @*   <th>
                    @Html.DisplayNameFor(model => model.DefaultReplyToName)
                </th> *@
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>

                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (item, index) in Model.Select((value, i) => (value, i)))
            {
                <tr>
                    <td>@(index + 1)</td>

                    <td>
                        @Html.DisplayFor(modelItem => item.DefaultFromName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DefaultFromAddress)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DefaultReplyToAddress)
                    </td>
                   @*  <td>
                        @Html.DisplayFor(modelItem => item.DefaultReplyToName)
                    </td> *@
                    <td>
                        @Html.DisplayFor(modelItem => item.Status)
                    </td>

                    <td>
                        <a href="@Url.Action("EditSysPrefSecurityEmail", new { emailId = item.SysPrefSecurityEmailId })" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <a href="#" onclick="confirmDelete('@item.SysPrefSecurityEmailId')" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</body>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js" integrity="sha512-VEd+nq25CkR676O+pLBnDW09R7VQX9Mdiij052gVCp5yVH3jGtH70Ho/UUv4mJDsEdTvqRCFZg0NKGiojGnUCw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="~/js/SysPrefSecurityEmail/SysPrefSecurityEmail.js"></script>
@if (TempData["Message"] != null)
{
    <script type="text/javascript">
        toastr.success('@TempData["Message"]');
    </script>
}