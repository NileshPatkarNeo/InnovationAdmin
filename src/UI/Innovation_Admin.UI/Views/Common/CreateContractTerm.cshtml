@model Innovation_Admin.UI.Models.ContractTerms.CreateContractTermDto

@{
    Layout = "~/Views/Shared/_AdminHomePage.cshtml";
}

<head>
    <link href="~/css/ReceiptBatchSource/CreateReceiptBatchSource.css" rel="stylesheet" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</head>
<body>

<h1>Create Contract Term</h1>

    <div class="form-container">
        <form asp-action="CreateContractTerm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label">Name<span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ContractType" class="control-label">Contract Type<span class="text-danger">*</span></label>
                <input asp-for="ContractType" class="form-control" />
                <span asp-validation-for="ContractType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ContractTypeCode" class="control-label">Contract Type Code<span class="text-danger">*</span></label>
                <input asp-for="ContractTypeCode" class="form-control" />
                <span asp-validation-for="ContractTypeCode" class="text-danger"></span>
            </div>
            <div class="button-container">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="ContractTerms" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>

</body>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
